{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "campusfind-api": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm ci"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "campusfind-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
